# ================================================================
# blulens — ตัวแปรสภาพแวดล้อม dev (คัดลอกเป็น .env ที่ root โปรเจกต์)
# พอร์ตฝั่ง host ตั้งไม่ชนกับ kpaccv2/bad8bit ที่รันบนเครื่องเดียวกัน
# ================================================================

# ---- Database (PostgreSQL 16 จาก docker-compose) ----
# ใช้ role blulens_app (ไม่ใช่ superuser)
DATABASE_URL="postgresql://blulens_app:blulens_app@localhost:5442/blulens?schema=public"

# ---- Redis (คิวงาน / cache) ----
REDIS_URL="redis://localhost:6389"

# ---- JWT (ยังไม่ใช้ใน skeleton — เตรียมไว้สำหรับ auth) ----
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800

# ---- API server ----
API_PORT=3101
WEB_URL="http://localhost:3100"
COOKIE_SECURE=false

# ---- Web (Next.js) ----
# URL ของ API ที่ Next.js ใช้ rewrite /api/* ไปหา — อ่านตอน `next dev`/`next build` เท่านั้น
# (rewrite ถูกฝังลง build) ดู README หัวข้อ "API_URL และโดเมนไฟล์"
API_URL="http://localhost:3101"

# ---- S3-compatible storage (MinIO ตอน dev — เก็บคลิปวิดีโอ) ----
S3_ENDPOINT="http://localhost:9100"
# host ที่ใช้เซ็น presigned URL ให้เบราว์เซอร์ — dev = MinIO ตรง, prod = โดเมนไฟล์หลัง Caddy
S3_PUBLIC_ENDPOINT="http://localhost:9100"
S3_ACCESS_KEY="minio"
S3_SECRET_KEY="minio123"
S3_BUCKET="clips"
S3_REGION="us-east-1"

# ---- Seed (pnpm db:seed) — บัญชี Admin เริ่มต้นสำหรับ dev เท่านั้น; production ตั้งค่าจริงบนเครื่อง ----
SEED_ADMIN_EMAIL="admin@blulens.local"
SEED_ADMIN_PASSWORD="ChangeMe-dev-only-123"
# demo data for the bl-21 slice (dev only): committee@blulens.local, member1..6@blulens.local, 3 teams
SEED_DEMO=1
SEED_DEMO_PASSWORD="ChangeMe-demo-only-123"
