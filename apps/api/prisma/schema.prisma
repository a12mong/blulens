// blulens — Prisma schema (bl-07, + bl-20 tournament-format tables)
// Design notes: docs/backend/schema-draft.md · specs: docs/specs/{architecture,grading,draw,tournament-format}.md
// Constraints Prisma cannot express (CHECKs, partial unique indexes, append-only triggers) live as raw SQL
// at the end of the init migration and are covered by apps/api/test/schema-constraints.e2e-spec.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- identity

/// Fixed role set (A2). Guest = not logged in, never stored.
enum Role {
  Admin
  Committee
  Umpire
  Reviewer
  Member
}

enum UserStatus {
  active
  disabled
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  /// Stored lower-cased by the application; unique.
  email        String     @unique
  passwordHash String     @map("password_hash")
  displayName  String     @map("display_name") @db.VarChar(80)
  status       UserStatus @default(active)
  /// Anonymised on account deletion (PDPA, S8); rows stay for result history.
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles         UserRole[]
  refreshTokens RefreshToken[]
  memberships   TeamMembership[]
  assessments   Assessment[]       @relation("AssessmentSubject")
  assignments   ReviewAssignment[] @relation("AssignmentReviewer")
  entryPlayers  EntryPlayer[]
  notifications Notification[]

  @@map("users")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  role      Role
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------- teams (A8 type-ahead, A11 multi-team)

enum TeamStatus {
  active
  archived
}

enum TeamRequestStatus {
  pending
  created
  aliased
  rejected
}

model Team {
  id           String           @id @default(uuid()) @db.Uuid
  name         String           @db.VarChar(120)
  /// normalizeTeamName(name) from @blulens/shared — unique (RG-07 race-safe).
  nameKey      String           @unique @map("name_key") @db.VarChar(120)
  shortName    String?          @map("short_name") @db.VarChar(20)
  status       TeamStatus       @default(active)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  aliases      TeamAlias[]
  memberships  TeamMembership[]
  entryPlayers EntryPlayer[]

  @@map("teams")
}

model TeamAlias {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  alias     String   @db.VarChar(120)
  /// Unique among aliases; the service also rejects a key equal to any teams.name_key.
  aliasKey  String   @unique @map("alias_key") @db.VarChar(120)
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("team_aliases")
}

/// "Request new team" when type-ahead finds nothing (architecture §6.6).
model TeamRequest {
  id             String            @id @default(uuid()) @db.Uuid
  requestedBy    String            @map("requested_by") @db.Uuid
  text           String            @db.VarChar(120)
  textKey        String            @map("text_key") @db.VarChar(120)
  status         TeamRequestStatus @default(pending)
  resolvedTeamId String?           @map("resolved_team_id") @db.Uuid
  resolvedBy     String?           @map("resolved_by") @db.Uuid
  resolvedAt     DateTime?         @map("resolved_at") @db.Timestamptz(3)
  reason         String?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status])
  @@map("team_requests")
}

/// Several concurrent teams per player are allowed (A11). validTo null = current.
/// Partial unique (user_id, team_id) WHERE valid_to IS NULL is in the migration SQL.
model TeamMembership {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  teamId    String    @map("team_id") @db.Uuid
  validFrom DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@index([userId, validFrom])
  @@index([teamId])
  @@map("team_memberships")
}

// ---------------------------------------------------------------- assessments (grading.md)

enum AssessmentStatus {
  draft
  submitted
  in_review
  /// grading v2 G17: n = 1 result awaiting Committee confirmation.
  provisional
  needs_reviewers
  disputed
  pending_approval
  approved
  overridden
  rejected
  withdrawn
}

/// provisional is reserved for grading.md v2 (few-reviewer mode).
enum ResultStatus {
  needs_reviewers
  provisional
  pending_approval
  disputed
  approved
  overridden
}

enum ResultSource {
  computed
  override
}

enum GradeKind {
  exact
  straddle
  wide
}

enum AssignmentState {
  open
  submitted
  expired
  declined
}

enum ClipStatus {
  pending_upload
  uploaded
  rejected
}

/// One version per row, never edited (G1). Exactly one active row (partial unique in SQL).
model Rubric {
  id            String       @id @default(uuid()) @db.Uuid
  methodVersion String       @unique @map("method_version")
  /// [{ key, nameTh, weight, anchorsTh }]
  criteria      Json
  /// N_min, outlier thresholds, margin parameters at that version.
  params        Json
  active        Boolean      @default(false)
  /// Set when first activated (trigger). Status: active -> active; activatedAt set -> retired; else draft (at most one).
  activatedAt   DateTime?    @map("activated_at") @db.Timestamptz(3)
  createdBy     String?      @map("created_by") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  assessments   Assessment[]

  @@map("rubrics")
}

model Assessment {
  id              String                 @id @default(uuid()) @db.Uuid
  subjectUserId   String                 @map("subject_user_id") @db.Uuid
  /// Set when bound to an event that requires a fresh assessment (A13).
  eventId         String?                @map("event_id") @db.Uuid
  /// Locked at submit; every review of this request uses the same rubric.
  rubricId        String?                @map("rubric_id") @db.Uuid
  /// Member's context for the assigned reviewers and the Committee (e.g. "clip 2 = doubles, I'm on the left").
  note            String?                @db.VarChar(1000)
  status          AssessmentStatus       @default(draft)
  /// Copied from events.min_reviewers, or the system default 2 for standalone requests (G3'). CHECK 1..5.
  reviewsRequired Int                    @default(2) @map("reviews_required") @db.SmallInt
  submittedAt     DateTime?              @map("submitted_at") @db.Timestamptz(3)
  /// Optimistic lock for state transitions.
  version         Int                    @default(0)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  subject         User                   @relation("AssessmentSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  event           Event?                 @relation(fields: [eventId], references: [id], onDelete: Restrict)
  rubric          Rubric?                @relation(fields: [rubricId], references: [id], onDelete: Restrict)
  clips           Clip[]
  assignments     ReviewAssignment[]
  results         AssessmentResult[]
  transitions     AssessmentTransition[]
  secondOpinions  SecondOpinion[]

  @@index([subjectUserId, createdAt])
  @@index([status])
  @@index([eventId])
  @@map("assessments")
}

/// Append-only history of the state machine (grading.md §8). UPDATE/DELETE blocked by trigger.
model AssessmentTransition {
  id           String           @id @default(uuid()) @db.Uuid
  assessmentId String           @map("assessment_id") @db.Uuid
  fromStatus   AssessmentStatus @map("from_status")
  toStatus     AssessmentStatus @map("to_status")
  /// null = system (job).
  actorId      String?          @map("actor_id") @db.Uuid
  reason       String?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  assessment   Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Restrict)

  @@index([assessmentId, createdAt])
  @@map("assessment_transitions")
}

model Clip {
  id              String     @id @default(uuid()) @db.Uuid
  assessmentId    String     @map("assessment_id") @db.Uuid
  /// clips/<assessmentId>/<clipId>
  objectKey       String     @unique @map("object_key")
  status          ClipStatus @default(pending_upload)
  contentType     String?    @map("content_type")
  sizeBytes       BigInt?    @map("size_bytes")
  sha256          String?    @db.Char(64)
  durationSec     Int?       @map("duration_sec")
  uploadExpiresAt DateTime?  @map("upload_expires_at") @db.Timestamptz(3)
  /// File purge date after approval (PDPA, S8).
  purgeAfter      DateTime?  @map("purge_after") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, sha256])
  @@map("clips")
}

/// Partial unique (assessment_id, reviewer_id) WHERE state IN ('open','submitted') is in the migration SQL.
enum AssignmentKind {
  assessment
  calibration
}

/// kind = assessment -> assessment_id set; kind = calibration -> calibration_clip_id set (CHECK in SQL).
/// Calibration work looks identical to the reviewer (G19b).
model ReviewAssignment {
  id                String           @id @default(uuid()) @db.Uuid
  kind              AssignmentKind   @default(assessment)
  assessmentId      String?          @map("assessment_id") @db.Uuid
  calibrationClipId String?          @map("calibration_clip_id") @db.Uuid
  reviewerId        String           @map("reviewer_id") @db.Uuid
  state             AssignmentState  @default(open)
  dueAt             DateTime         @map("due_at") @db.Timestamptz(3)
  declineReason     String?          @map("decline_reason")
  /// null = automatic assignment.
  assignedBy        String?          @map("assigned_by") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  assessment        Assessment?      @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  calibrationClip   CalibrationClip? @relation(fields: [calibrationClipId], references: [id], onDelete: Restrict)
  reviewer          User             @relation("AssignmentReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  review            Review?
  secondOpinion     SecondOpinion?

  @@index([reviewerId, state])
  @@index([assessmentId])
  @@index([calibrationClipId])
  @@map("review_assignments")
}

enum SecondOpinionRequester {
  member
  committee
}

/// G20: the player may ask once per request within 14 days of the result; the Committee any time.
/// Partial unique (assessment_id) WHERE requester = 'member' is in the migration SQL.
model SecondOpinion {
  id           String                 @id @default(uuid()) @db.Uuid
  assessmentId String                 @map("assessment_id") @db.Uuid
  requestedBy  String                 @map("requested_by") @db.Uuid
  requester    SecondOpinionRequester
  /// The extra review assignment created for it.
  assignmentId String?                @unique @map("assignment_id") @db.Uuid
  reason       String?
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  assessment   Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  assignment   ReviewAssignment?      @relation(fields: [assignmentId], references: [id], onDelete: Restrict)

  @@index([assessmentId])
  @@map("second_opinions")
}

/// G19b: quarterly calibration clips with Committee reference grades.
model CalibrationSet {
  id          String            @id @default(uuid()) @db.Uuid
  name        String            @db.VarChar(120)
  description String?
  /// e.g. 2026-Q4
  period      String?           @db.VarChar(16)
  active      Boolean           @default(true)
  /// Set by POST /calibration-sets/{id}/assign; clips are frozen after (409 CALIBRATION_SET_ASSIGNED).
  assignedAt  DateTime?         @map("assigned_at") @db.Timestamptz(3)
  createdBy   String            @map("created_by") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  clips       CalibrationClip[]

  @@map("calibration_sets")
}

model CalibrationClip {
  id             String             @id @default(uuid()) @db.Uuid
  setId          String             @map("set_id") @db.Uuid
  objectKey      String             @unique @map("object_key")
  /// Committee reference grade as a ladder index 0..14 (CHECK in SQL).
  referenceIndex Int                @map("reference_index") @db.SmallInt
  status         ClipStatus         @default(pending_upload)
  contentType    String?            @map("content_type")
  sizeBytes      BigInt?            @map("size_bytes")
  sha256         String?            @db.Char(64)
  durationSec    Int?               @map("duration_sec")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  set            CalibrationSet     @relation(fields: [setId], references: [id], onDelete: Restrict)
  assignments    ReviewAssignment[]

  @@index([setId])
  @@map("calibration_clips")
}

/// One review per assignment; immutable once submitted (blind review).
model Review {
  id           String           @id @default(uuid()) @db.Uuid
  assignmentId String           @unique @map("assignment_id") @db.Uuid
  comment      String?          @db.VarChar(2000)
  /// v_j computed at submit (ladder units), null when abstained.
  overall      Decimal?         @db.Decimal(6, 4)
  abstained    Boolean          @default(false)
  submittedAt  DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(3)
  assignment   ReviewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  scores       ReviewScore[]

  @@map("reviews")
}

model ReviewScore {
  reviewId   String @map("review_id") @db.Uuid
  criterion  String @db.VarChar(40)
  /// Ladder index 0..14 (CHECK in SQL); null = cannot assess from the clip.
  gradeIndex Int?   @map("grade_index") @db.SmallInt
  review     Review @relation(fields: [reviewId], references: [id], onDelete: Restrict)

  @@id([reviewId, criterion])
  @@map("review_scores")
}

/// The bad8bit-shaped grade (TEAM.md §6) as an append-only snapshot (G9).
/// Approving = a new row copying the numbers with status approved. UPDATE/DELETE blocked by trigger.
model AssessmentResult {
  id            String        @id @default(uuid()) @db.Uuid
  assessmentId  String        @map("assessment_id") @db.Uuid
  version       Int
  source        ResultSource
  status        ResultStatus
  /// Ladder units 0..14.9999; null only for needs_reviewers (G15).
  score         Decimal?      @db.Decimal(6, 4)
  margin        Decimal?      @db.Decimal(6, 4)
  lowerIndex    Int?          @map("lower_index") @db.SmallInt
  upperIndex    Int?          @map("upper_index") @db.SmallInt
  centerIndex   Int?          @map("center_index") @db.SmallInt
  kind          GradeKind?
  label         String?       @db.VarChar(20)
  nRaters       Int           @map("n_raters") @db.SmallInt
  nExcluded     Int           @default(0) @map("n_excluded") @db.SmallInt
  spread        Decimal?      @db.Decimal(6, 4)
  flags         String[]      @default([])
  methodVersion String        @map("method_version")
  /// Raw v_j, exclusions, robust z, all parameters used.
  inputs        Json
  /// Required for override (>= 20 chars) and for approving a disputed result.
  reason        String?
  /// G16: no expiry for now; reserved.
  expiresAt     DateTime?     @map("expires_at") @db.Timestamptz(3)
  computedAt    DateTime      @default(now()) @map("computed_at") @db.Timestamptz(3)
  /// null = computed by the system.
  computedBy    String?       @map("computed_by") @db.Uuid
  assessment    Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  entryPlayers  EntryPlayer[]

  @@unique([assessmentId, version])
  @@index([status, computedAt])
  @@map("assessment_results")
}

// ---------------------------------------------------------------- rater stats (Kappa, grading.md §5)

model RaterAgreementSnapshot {
  id              String          @id @default(uuid()) @db.Uuid
  window          String          @db.VarChar(10)
  windowStart     DateTime        @map("window_start") @db.Timestamptz(3)
  windowEnd       DateTime        @map("window_end") @db.Timestamptz(3)
  methodVersion   String          @map("method_version")
  /// null = undefined or insufficient data (G12).
  fleissKappaTier Decimal?        @map("fleiss_kappa_tier") @db.Decimal(6, 4)
  fleissN         Int             @default(0) @map("fleiss_n")
  trigger         String          @db.VarChar(10)
  computedAt      DateTime        @default(now()) @map("computed_at") @db.Timestamptz(3)
  raters          RaterStat[]
  pairs           RaterPairStat[]

  @@index([computedAt])
  @@map("rater_agreement_snapshots")
}

model RaterStat {
  snapshotId       String                 @map("snapshot_id") @db.Uuid
  reviewerId       String                 @map("reviewer_id") @db.Uuid
  reviews          Int
  bias             Decimal?               @db.Decimal(6, 4)
  kappaVsConsensus Decimal?               @map("kappa_vs_consensus") @db.Decimal(6, 4)
  kappaN           Int                    @default(0) @map("kappa_n")
  outlierRate      Decimal?               @map("outlier_rate") @db.Decimal(6, 4)
  /// G19b: mean(overall - (referenceIndex + 0.5)) over calibration clips in the window.
  calibrationBias  Decimal?               @map("calibration_bias") @db.Decimal(6, 4)
  calibrationMae   Decimal?               @map("calibration_mae") @db.Decimal(6, 4)
  calibrationN     Int                    @default(0) @map("calibration_n")
  flagged          Boolean                @default(false)
  snapshot         RaterAgreementSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([snapshotId, reviewerId])
  @@map("rater_stats")
}

model RaterPairStat {
  snapshotId          String                 @map("snapshot_id") @db.Uuid
  reviewerA           String                 @map("reviewer_a") @db.Uuid
  reviewerB           String                 @map("reviewer_b") @db.Uuid
  cohenKappaQuadratic Decimal?               @map("cohen_kappa_quadratic") @db.Decimal(6, 4)
  nShared             Int                    @map("n_shared")
  snapshot            RaterAgreementSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@id([snapshotId, reviewerA, reviewerB])
  @@map("rater_pair_stats")
}

// ---------------------------------------------------------------- tournaments, events, entries

enum TournamentStatus {
  draft
  open
  closed
  running
  finished
}

enum Discipline {
  MS
  WS
  MD
  WD
  XD
}

/// architecture §6.10 (bl-21): Admin/Committee create -> forward -> Committee approves/rejects.
/// Draws and group draws use approved entries only.
enum EntryStatus {
  draft
  pending_committee
  approved
  rejected
  withdrawn
}

model Tournament {
  id             String           @id @default(uuid()) @db.Uuid
  name           String           @db.VarChar(160)
  venue          String?          @db.VarChar(160)
  startsOn       DateTime         @map("starts_on") @db.Date
  entriesCloseAt DateTime         @map("entries_close_at") @db.Timestamptz(3)
  status         TournamentStatus @default(draft)
  createdBy      String?          @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  events         Event[]

  @@map("tournaments")
}

model Event {
  id                      String        @id @default(uuid()) @db.Uuid
  tournamentId            String        @map("tournament_id") @db.Uuid
  discipline              Discipline
  gradeMinIndex           Int           @map("grade_min_index") @db.SmallInt
  gradeMaxIndex           Int           @map("grade_max_index") @db.SmallInt
  maxEntries              Int?          @map("max_entries") @db.SmallInt
  /// tournament-format.md §2 settings + both match formats; locked once drawn.
  format                  Json?
  formatLockedAt          DateTime?     @map("format_locked_at") @db.Timestamptz(3)
  /// A13: entering requires an approved assessment bound to this event.
  requiresFreshAssessment Boolean       @default(false) @map("requires_fresh_assessment")
  /// grading v2 G3': valid reviews needed before a result is computed (1-5, CHECK in SQL).
  minReviewers            Int           @default(2) @map("min_reviewers") @db.SmallInt
  /// A14 transparency: Committee/Admin disclosure overriding hidden grades.
  gradesDisclosedAt       DateTime?     @map("grades_disclosed_at") @db.Timestamptz(3)
  gradesDisclosedBy       String?       @map("grades_disclosed_by") @db.Uuid
  gradesDisclosedReason   String?       @map("grades_disclosed_reason")
  createdAt               DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  tournament              Tournament    @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  entries                 Entry[]
  draws                   Draw[]
  groups                  Group[]
  matches                 Match[]
  umpires                 EventUmpire[]
  assessments             Assessment[]

  @@unique([tournamentId, discipline, gradeMinIndex, gradeMaxIndex])
  @@map("events")
}

/// = "registration". Grade visibility is derived (consent of every player, or event disclosure) — not stored.
model Entry {
  id             String        @id @default(uuid()) @db.Uuid
  eventId        String        @map("event_id") @db.Uuid
  status         EntryStatus   @default(draft)
  /// Optional pair/team display name.
  name           String?       @db.VarChar(80)
  reserveRank    Int?          @map("reserve_rank") @db.SmallInt
  forwardedAt    DateTime?     @map("forwarded_at") @db.Timestamptz(3)
  decidedBy      String?       @map("decided_by") @db.Uuid
  decidedAt      DateTime?     @map("decided_at") @db.Timestamptz(3)
  /// Required (>= 20 chars) for reject and for approving an out-of-band grade.
  decisionReason String?       @map("decision_reason")
  withdrawnAt    DateTime?     @map("withdrawn_at") @db.Timestamptz(3)
  createdBy      String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  players        EntryPlayer[]

  @@index([eventId, status])
  @@map("entries")
}

model EntryPlayer {
  entryId       String            @map("entry_id") @db.Uuid
  userId        String            @map("user_id") @db.Uuid
  /// Copied from entries.event_id so one player has at most one entry per event.
  eventId       String            @map("event_id") @db.Uuid
  /// Approved result that qualified the player at entry time.
  gradeResultId String?           @map("grade_result_id") @db.Uuid
  /// A14: player's consent to show the grade for this entry (default hidden).
  gradeConsent  Boolean           @default(false) @map("grade_consent")
  /// Club picked for this entry via the team type-ahead (A8); null = no club.
  teamId        String?           @map("team_id") @db.Uuid
  entry         Entry             @relation(fields: [entryId], references: [id], onDelete: Cascade)
  team          Team?             @relation(fields: [teamId], references: [id], onDelete: Restrict)
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  gradeResult   AssessmentResult? @relation(fields: [gradeResultId], references: [id], onDelete: Restrict)

  @@id([entryId, userId])
  @@unique([eventId, userId])
  @@map("entry_players")
}

/// Umpire assignment per event; empty courts = every court (tournament-format §5.1).
model EventUmpire {
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  courts    String[] @default([])
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@map("event_umpires")
}

// ---------------------------------------------------------------- draws, groups, matches (draw.md, tournament-format.md)

enum DrawKind {
  knockout
  group
}

enum DrawStatus {
  preview
  published
  discarded
  superseded
  locked
}

enum SeedSource {
  server
  committee
}

/// Partial unique (event_id, kind) WHERE status = 'published' is in the migration SQL (DR-14).
model Draw {
  id                       String     @id @default(uuid()) @db.Uuid
  eventId                  String     @map("event_id") @db.Uuid
  kind                     DrawKind   @default(knockout)
  version                  Int
  status                   DrawStatus @default(preview)
  seed                     String
  seedSource               SeedSource @map("seed_source")
  inputHash                String     @map("input_hash") @db.Char(64)
  /// Entries, team sets and seedScore at draw date (draw.md §2).
  snapshot                 Json
  rulesetVersion           String     @map("ruleset_version")
  prngId                   String     @map("prng_id")
  size                     Int        @db.SmallInt
  seedsCount               Int        @map("seeds_count") @db.SmallInt
  sameTeamR1Count          Int        @default(0) @map("same_team_r1_count") @db.SmallInt
  minimumPossibleConflicts Int        @default(0) @map("minimum_possible_conflicts") @db.SmallInt
  provenMinimal            Boolean    @default(true) @map("proven_minimal")
  conflicts                Json       @default("[]")
  conflictsAcknowledgedBy  String?    @map("conflicts_acknowledged_by") @db.Uuid
  conflictsAcknowledgedAt  DateTime?  @map("conflicts_acknowledged_at") @db.Timestamptz(3)
  searchStats              Json?      @map("search_stats")
  /// Required for every preview after the first and for supersede (D5/D8).
  reason                   String?
  /// Knockout after groups: the group draw whose confirmed standings fed it.
  sourceGroupDrawId        String?    @map("source_group_draw_id") @db.Uuid
  createdBy                String     @map("created_by") @db.Uuid
  createdAt                DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  event                    Event      @relation(fields: [eventId], references: [id], onDelete: Restrict)
  slots                    DrawSlot[]
  groups                   Group[]
  matches                  Match[]

  @@unique([eventId, kind, version])
  @@map("draws")
}

model DrawSlot {
  drawId   String  @map("draw_id") @db.Uuid
  position Int     @db.SmallInt
  /// null = bye.
  entryId  String? @map("entry_id") @db.Uuid
  seedNo   Int?    @map("seed_no") @db.SmallInt
  draw     Draw    @relation(fields: [drawId], references: [id], onDelete: Cascade)

  @@id([drawId, position])
  @@unique([drawId, entryId])
  @@map("draw_slots")
}

model Group {
  id        String          @id @default(uuid()) @db.Uuid
  eventId   String          @map("event_id") @db.Uuid
  drawId    String          @map("draw_id") @db.Uuid
  label     String          @db.VarChar(4)
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  draw      Draw            @relation(fields: [drawId], references: [id], onDelete: Cascade)
  members   GroupMember[]
  matches   Match[]
  standings GroupStanding[]

  @@unique([drawId, label])
  @@map("groups")
}

model GroupMember {
  groupId     String @map("group_id") @db.Uuid
  entryId     String @map("entry_id") @db.Uuid
  seedInGroup Int    @map("seed_in_group") @db.SmallInt
  pot         Int    @db.SmallInt
  group       Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([groupId, entryId])
  @@map("group_members")
}

enum MatchStage {
  group
  knockout
  third_place
}

enum MatchStatus {
  scheduled
  bye
  reported
  confirmed
  walkover
  void
}

enum MatchResult {
  a_win
  b_win
  draw
  walkover_a
  walkover_b
  void
}

/// Two-step result (F12): Umpire reports -> Committee confirms. Every change is audited;
/// result_version increments on each correction of a confirmed result.
model Match {
  id            String       @id @default(uuid()) @db.Uuid
  eventId       String       @map("event_id") @db.Uuid
  drawId        String       @map("draw_id") @db.Uuid
  stage         MatchStage
  groupId       String?      @map("group_id") @db.Uuid
  round         Int          @db.SmallInt
  matchNo       Int          @map("match_no") @db.SmallInt
  court         String?      @db.VarChar(20)
  umpireId      String?      @map("umpire_id") @db.Uuid
  /// "a" side.
  topEntryId    String?      @map("top_entry_id") @db.Uuid
  /// "b" side.
  bottomEntryId String?      @map("bottom_entry_id") @db.Uuid
  /// [{ a, b }] points per game.
  games         Json?
  result        MatchResult?
  winnerEntryId String?      @map("winner_entry_id") @db.Uuid
  status        MatchStatus  @default(scheduled)
  resultVersion Int          @default(0) @map("result_version")
  reportedBy    String?      @map("reported_by") @db.Uuid
  reportedAt    DateTime?    @map("reported_at") @db.Timestamptz(3)
  confirmedBy   String?      @map("confirmed_by") @db.Uuid
  confirmedAt   DateTime?    @map("confirmed_at") @db.Timestamptz(3)
  /// e.g. UMPIRE_TEAM_CONFLICT.
  flags         String[]     @default([])
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  draw          Draw         @relation(fields: [drawId], references: [id], onDelete: Restrict)
  group         Group?       @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@unique([drawId, matchNo])
  @@index([eventId, status])
  @@index([umpireId, status])
  @@map("matches")
}

enum Qualification {
  qualified
  best_third
  out
}

/// Snapshot taken when the Committee confirms the group stage (F13, §4.4).
model GroupStanding {
  groupId       String        @map("group_id") @db.Uuid
  entryId       String        @map("entry_id") @db.Uuid
  rank          Int           @db.SmallInt
  played        Int           @db.SmallInt
  won           Int           @db.SmallInt
  drawn         Int           @db.SmallInt
  lost          Int           @db.SmallInt
  points        Int           @db.SmallInt
  pointsFor     Int           @map("points_for")
  pointsAgainst Int           @map("points_against")
  diff          Int
  tiebreakNote  String?       @map("tiebreak_note")
  qualification Qualification
  confirmedBy   String        @map("confirmed_by") @db.Uuid
  confirmedAt   DateTime      @default(now()) @map("confirmed_at") @db.Timestamptz(3)
  group         Group         @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@id([groupId, entryId])
  @@map("group_standings")
}

// ---------------------------------------------------------------- audit

/// Append-only (UPDATE/DELETE blocked by trigger). No delete endpoint.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  /// null = system.
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(60)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String   @map("entity_id") @db.VarChar(64)
  before     Json?
  after      Json?
  reason     String?
  ip         String?  @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

/// In-app notification (bl-39, docs/specs/notifications.md). type is text, see NotificationType in the service.
model Notification {
  id              String    @id @default(uuid()) @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  type            String
  title           String    @db.VarChar(200)
  body            String?   @db.VarChar(1000)
  /// in-app path starting with / (CHECK in SQL)
  link            String?
  readAt          DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  recipient       User      @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt, createdAt(sort: Desc)], map: "notifications_recipient_read_created_idx")
  @@map("notifications")
}
