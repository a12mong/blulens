# deploy/.env.example — VARIABLE NAMES AND COMMENTS ONLY. Never commit a value.
# On the Droplet: cp .env.example .env, fill every value there (chmod 600 .env). See docs/ops/runbook.md.
# Generate secrets on the server, e.g. `openssl rand -hex 32` (one per secret, never reused).

# ---- instance identity ----
# Compose project name; live = blulens, an optional second instance = blulens-dev
COMPOSE_PROJECT_NAME=
# Name prefix Caddy uses to reach this instance on the shared `edge` network: live | dev
EDGE_ALIAS=
# `edge` on the live instance (runs Caddy), empty on a dev instance
COMPOSE_PROFILES=
# GitHub user/org that owns the ghcr.io images (ghcr.io/<owner>/blulens-api, -web)
GHCR_OWNER=
# Image tag to run: a release tag or a commit sha; rollback = set the previous tag (runbook)
IMAGE_TAG=

# ---- domains (DNS A records -> Droplet IP) ----
# Main site, e.g. app.<domain>
SITE_ADDRESS=
# Optional dev instance site; empty disables it
DEV_SITE_ADDRESS=
# File domain (MinIO behind Caddy) for presigned clip URLs, e.g. files.<domain>
FILES_ADDRESS=
# Optional dev instance file domain; empty disables it
DEV_FILES_ADDRESS=
# Public URL of the web app (https://<SITE_ADDRESS>); used for CORS and cookies
WEB_URL=

# ---- PostgreSQL 16 ----
# Superuser created on first boot (only for maintenance and backups)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Password of the non-superuser app role blulens_app (created by postgres-init.sh on first boot)
BLULENS_APP_PASSWORD=
# App connection: postgresql://blulens_app:<BLULENS_APP_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=public
DATABASE_URL=
# Host port bound to 127.0.0.1 only (SSH tunnel access); default 5432
DB_HOST_PORT=

# ---- Redis ----
# Default redis://redis:6379 (internal network only)
REDIS_URL=

# ---- MinIO (S3-compatible clip storage) ----
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Credentials the API uses (may equal the MinIO root pair on a single Droplet)
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Private bucket, created by the API on first upload; default clips
S3_BUCKET=
# Default us-east-1 (MinIO ignores it, the SDK needs one)
S3_REGION=
# https://<FILES_ADDRESS>: presigned URLs are signed for this host
S3_PUBLIC_ENDPOINT=

# ---- auth ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Defaults 900 and 604800 seconds
JWT_ACCESS_TTL_SEC=
JWT_REFRESH_TTL_SEC=
# true behind HTTPS (default)
COOKIE_SECURE=

# ---- first boot / seed ----
# 1 = run the idempotent seed at container start (first deploy); set back to 0 afterwards
SEED_ON_BOOT=
# Bootstrap Admin account created by the seed (password is never overwritten on re-runs)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# 1 = also create the demo club data (never on the real production instance)
SEED_DEMO=
SEED_DEMO_PASSWORD=

# ---- backups (deploy/backup.sh) ----
# Folder on the Droplet that receives the dumps and the clip mirror, e.g. /var/backups/blulens
BACKUP_DIR=
# Days of database dumps to keep; default 14
BACKUP_KEEP_DAYS=
