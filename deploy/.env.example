# Production .env (วางข้าง deploy/docker-compose.yml บน Droplet) — ใส่ค่าจริงบนเครื่องเท่านั้น
COMPOSE_PROJECT_NAME=blulens
EDGE_ALIAS=live
COMPOSE_PROFILES=edge
GHCR_OWNER=a12mong
IMAGE_TAG=latest

SITE_ADDRESS=app.example.com
DEV_SITE_ADDRESS=
# โดเมนไฟล์ (MinIO หลัง Caddy) — ต้องมี DNS A record ชี้ Droplet เหมือนโดเมนหลัก
FILES_ADDRESS=files.example.com
DEV_FILES_ADDRESS=

POSTGRES_USER=blulens
POSTGRES_PASSWORD=
POSTGRES_DB=blulens
BLULENS_APP_PASSWORD=
DATABASE_URL=postgresql://blulens_app:<BLULENS_APP_PASSWORD>@postgres:5432/blulens?schema=public

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=clips
# host ที่ใช้เซ็น presigned URL (ฝั่ง dev instance ใช้โดเมน files-dev)
S3_PUBLIC_ENDPOINT=https://files.example.com

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
WEB_URL=https://app.example.com
