{
  "name": "blulens",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @blulens/shared build && pnpm --filter @blulens/api db:generate && turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @blulens/api db:migrate",
    "db:deploy": "pnpm --filter @blulens/api db:deploy",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:seed": "pnpm --filter @blulens/api db:seed",
    "db:setup": "pnpm --filter @blulens/api db:setup"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
